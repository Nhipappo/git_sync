[base]
name = RedOS - Base
baseurl = https://nexus.gazprom-neft.local/repository/yum-redos7-external-dso/$basearch/os
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-RED-SOFT
enabled = 1

[updates]
name = RedOS - Updates
baseurl = https://nexus.gazprom-neft.local/repository/yum-redos7-external-dso/$basearch/updates
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-RED-SOFT
enabled = 1
